# ==============================================================================
# Supabase Cloud PostgreSQL Database Configuration
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' (do NOT commit .env to version control).
# 2. In your Supabase Dashboard:
#    - Navigate to: Project Settings -> Database -> Connection Pooling
#    - Select the "URI" tab, Mode: "Session" (Port 5432).
#    - Replace [YOUR-PASSWORD] with your actual database password.
#    - NOTE: If your password contains special characters (@, #, :, /, %),
#      URL-encode them (e.g. # becomes %23, @ becomes %40).
#
# Recommended connection mode (Session Pooler - works on all IPv4 & IPv6 networks):
DATABASE_URL=postgresql+psycopg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# Alternative: Direct Connection (Port 5432 - requires IPv6 network support):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
